# Client SEO
# Final public website origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# Set this only when the real production domain is confirmed.
VITE_SITE_URL=

# Express API
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Set true in production when Express runs behind Nginx, Cloudflare, a load balancer, etc.
TRUST_PROXY=false

# MongoDB
# Example: mongodb+srv://username:password@cluster.mongodb.net/royalties_buffet
MONGODB_URI=

# Admin CMS
# These credentials seed the first MongoDB-backed admin account only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a cryptographically random value. Production minimum: 48 characters.
ADMIN_SESSION_SECRET=

# Optional in development. Configure both values together for real email delivery.
RESEND_API_KEY=
# Testing example: Royalties Buffet <onboarding@resend.dev>
# Production example: Royalties Buffet <admin@yourdomain.com>
ADMIN_FROM_EMAIL=
