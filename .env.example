# Client SEO
# Final public website origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# Set this only when the real production domain is confirmed.
VITE_SITE_URL=

# Express API
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# Example: mongodb+srv://username:password@cluster.mongodb.net/royalties_buffet
MONGODB_URI=

# Admin CMS
# These credentials seed the first MongoDB-backed admin account only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random value, minimum 32 characters.
ADMIN_SESSION_SECRET=

# Optional in development, required in production if Forgot Password should send email.
RESEND_API_KEY=
# Example: Royalties Buffet <admin@yourdomain.com>
ADMIN_FROM_EMAIL=
