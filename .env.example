# Client SEO
# Set to the final public production origin so canonical URLs, robots.txt and sitemap.xml are generated correctly.
VITE_SITE_URL=

# Express API / local development
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Vercel is detected automatically. Set true only for other production reverse proxies.
TRUST_PROXY=false

# MongoDB Atlas
# Example: mongodb+srv://username:password@cluster.mongodb.net/royalties_buffet
MONGODB_URI=

# Admin CMS
# These credentials seed the first MongoDB-backed admin account only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a cryptographically random value. Production minimum: 48 characters.
ADMIN_SESSION_SECRET=

# Optional in development. Configure both values together for real email delivery.
RESEND_API_KEY=
# Testing example: Royalties Buffet <onboarding@resend.dev>
# Production example: Royalties Buffet <noreply@yourdomain.com>
ADMIN_FROM_EMAIL=
