{
  "name": "royalties-buffet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names CLIENT,SERVER \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "node scripts/generate-seo.mjs && vite",
    "dev:server": "node --watch server/index.js",
    "build": "node scripts/generate-seo.mjs && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "server": "node server/index.js",
    "audit:static": "node scripts/audit-static.mjs",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run audit:static && npm run lint && npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "lucide-react": "^0.468.0",
    "mongoose": "9.9.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
